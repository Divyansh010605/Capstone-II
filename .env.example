# ==============================================================================
# Stock Market AI Prediction & Risk Analysis — Environment Configuration
# Copy this file to .env and adjust variables as required for local/docker runs.
# ==============================================================================

# ── 1. Backend Core Service ──
PROJECT_NAME="AI-Based Stock Market Trend Prediction & Risk Analysis"
API_V1_STR="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=False

# ── 2. Security & JWT Bearer Authentication ──
# Minimum 32-character high-entropy secret key for cryptographic token signing
SECRET_KEY=prod-stock-ai-risk-super-secure-jwt-secret-key-32chars-min!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 3. MongoDB Persistence ──
# Use 'localhost:27017' for local host Python, or 'mongodb:27017' inside Docker networks
MONGODB_URI=mongodb://localhost:27017/stock_market_ai
MONGODB_DB_NAME=stock_market_ai

# ── 4. AI / ML Prediction Engine Microservice ──
AI_ENGINE_URL=http://localhost:8001
DEFAULT_MODEL=ensemble
PREDICTION_HORIZON_DAYS=7
LOOKBACK_WINDOW=60

# ── 5. Email & OTP Password Reset Service ──
# If SMTP credentials are provided, real emails are dispatched.
# In local/offline development, OTPs are safely logged to the console and returned via dev payload.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@stockmarketai.internal
OTP_EXPIRY_MINUTES=10

# ── 6. OAuth Authentication (Google & GitHub) ──
# Leave blank to use built-in one-click development mock authorization
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── 7. Frontend Client (React / Vite) ──
# In Vite applications, client-facing environment variables must be prefixed with VITE_
VITE_API_URL=http://localhost:8000
PORT=3000

# ── 8. Cross-Origin Resource Sharing (CORS) ──
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173
