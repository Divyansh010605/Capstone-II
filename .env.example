# Environment configuration template
# Copy to .env and adjust values for production / local usage

# Backend Configuration
PROJECT_NAME="AI-Based Stock Market Trend Prediction & Risk Analysis"
API_V1_STR="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=False

# Security & JWT Authentication
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017/stock_market_ai
MONGODB_DB_NAME=stock_market_ai

# AI Engine Service
AI_ENGINE_URL=http://ai_engine:8001
DEFAULT_MODEL=ensemble
PREDICTION_HORIZON_DAYS=7
LOOKBACK_WINDOW=60

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
PORT=3000
